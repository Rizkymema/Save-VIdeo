# Alternatif Caddy: Nginx sebagai reverse proxy (app jalan di 127.0.0.1:3000).
# Sertifikat HTTPS: `sudo certbot --nginx -d domainkamu.com`
# Set di .env aplikasi: TRUST_PROXY_HEADER=x-real-ip

upstream savelink {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    server_name domainkamu.com www.domainkamu.com;
    return 301 https://domainkamu.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name domainkamu.com;

    ssl_certificate     /etc/letsencrypt/live/domainkamu.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/domainkamu.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 64k;   # API hanya menerima JSON kecil

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Progress Server-Sent Events: tanpa buffer, koneksi panjang.
    location ~ ^/api/jobs/[^/]+/events$ {
        proxy_pass http://savelink;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 3600s;
    }

    # Unduhan file besar: stream langsung ke user, jangan ditulis ke disk Nginx.
    location ~ ^/api/jobs/[^/]+/file$ {
        proxy_pass http://savelink;
        proxy_buffering off;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }

    location / {
        proxy_pass http://savelink;
        proxy_read_timeout 900s;
    }
}
