# ─── SaveLink — contoh konfigurasi ────────────────────────────────────────────
# Salin ke `.env.local` (dev) atau isi di docker-compose / panel hosting.
# Semua nilai opsional; default sudah aman untuk 1 VPS kecil.

# ─── Lokasi tool (biarkan ber-komentar di Docker: image sudah mengaturnya) ────
# Default: dicari di PATH. Isi hanya bila perlu (mis. di Windows saat dev).
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=
# JS runtime untuk yt-dlp (wajib agar format YouTube lengkap). Default yt-dlp: deno di PATH.
#   Contoh Windows: YTDLP_JS_RUNTIMES=deno:C:\path\ke\deno.exe
# YTDLP_JS_RUNTIMES=deno
# Folder file sementara (default: <tmp>/savelink). Hanya file job (nama UUID) yang dihapus.
# DOWNLOAD_DIR=
# Update yt-dlp otomatis (yt-dlp -U saat start + tiap 24 jam). Di Docker sudah aktif (true).
# YTDLP_AUTO_UPDATE=false

# Batasan & antrean
MAX_CONCURRENT_JOBS=3
MAX_JOBS_PER_IP=2
MAX_QUEUE_LENGTH=30
RATE_LIMIT_INFO_PER_MIN=15
RATE_LIMIT_JOBS_PER_10MIN=20
MAX_DURATION_SEC=7200
MAX_FILESIZE_MB=2048
MIN_FREE_DISK_MB=1024
JOB_TTL_MINUTES=30
DOWNLOAD_GRACE_MINUTES=5
INFO_TIMEOUT_SEC=30
JOB_TIMEOUT_SEC=900
INFO_CACHE_MINUTES=10

# Header IP asli user dari reverse proxy: x-forwarded-for | x-real-ip | cf-connecting-ip | none
TRUST_PROXY_HEADER=x-forwarded-for

# ─── Opsional ────────────────────────────────────────────────────────────────
# Proxy residensial bila IP server diblokir YouTube ("Sign in to confirm you're not a bot").
YTDLP_PROXY=
# HATI-HATI: akun bisa kena banned. Pakai akun cadangan, file cookies format Netscape.
YTDLP_COOKIES_FILE=
# Sama, tapi isi cookies.txt dalam base64 — untuk Vercel (tidak ada file permanen). Lihat DEPLOY.md bagian 13.
YTDLP_COOKIES_BASE64=

# Cloudflare Turnstile (captcha tak terlihat). Kosongkan untuk menonaktifkan.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Webhook Slack/Discord untuk alert bila error rate per platform tinggi.
ALERT_WEBHOOK_URL=

# URL publik situs (untuk metadata SEO, sitemap, OG image). Di-inline saat build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Mode unduhan ────────────────────────────────────────────────────────────
# jobs   = antrean + progress real-time (server Docker/VPS) — default di luar Vercel
# direct = satu request per unduhan (serverless) — default otomatis di Vercel
# DOWNLOAD_MODE=
# Mode direct: batas waktu proses & ukuran file (Vercel Hobby: total 300 dtk termasuk kirim file)
DIRECT_TIMEOUT_SEC=220
DIRECT_MAX_FILESIZE_MB=250

# ─── Mode hybrid: UI di Vercel + mesin download di server Docker (lihat DEPLOY.md) ───
# Di project Vercel: alamat server Docker (tanpa / di akhir). Kosong = API di server yang sama.
NEXT_PUBLIC_API_BASE=
# Di server Docker: origin UI yang boleh memanggil API, dipisah koma.
#   Contoh: CORS_ORIGINS=https://save-video.vercel.app,https://savelink.domainkamu.com
CORS_ORIGINS=

# ─── Khusus docker compose (lihat DEPLOY.md) ─────────────────────────────────
# Domain untuk HTTPS otomatis Caddy, tanpa https://, mis. savelink.domainkamu.com
DOMAIN=
